<?xml version="1.0" encoding="utf-8"?>
<Talents>
  <Talent identifier="robot_cap_fabrication">
    <Icon texture="Content/UI/TalentsIcons3.png" sheetindex="5,6" sheetelementsize="128,128" />
    <Description tag="talentdescription.unlockrecipe">
      <Replace tag="[itemname]" value="entityname.robotupgradecap" color="gui.orange" />
    </Description>
    <AddedRecipe itemidentifier="robotupgradecap" />
  </Talent>
  <Talent identifier="robot_melee_power">
    <Icon texture="Content/UI/TalentsIcons3.png" sheetindex="3,6" sheetelementsize="128,128" />
    <Description tag="talentdescription.additionalstattype">
      <Replace tag="[amount]" value="40" color="gui.green" />
      <Replace tag="[stattype]" value="stattypenames.meleeattackmultiplier" color="gui.orange" />
    </Description>
    <AbilityGroupEffect abilityeffecttype="None">
      <Abilities>
        <CharacterAbilityGiveStat stattype="MeleeAttackMultiplier" value="0.4" />
      </Abilities>
    </AbilityGroupEffect>
  </Talent>
  <Talent identifier="robot_melee_defense">
    <Icon texture="Content/UI/TalentsIcons3.png" sheetindex="4,6" sheetelementsize="128,128" />
    <Description tag="talentdescription.additionalstattype">
      <Replace tag="[amount]" value="20" color="gui.green"/>
      <Replace tag="[stattype]" value="stattypenames.physicalresistance" color="gui.orange" />
    </Description>
    <AbilityGroupEffect abilityeffecttype="None">
      <Abilities>
        <CharacterAbilityGiveResistance resistanceid="damage" multiplier="0.8" />
      </Abilities>
    </AbilityGroupEffect>
  </Talent>
  <Talent identifier="robot_belt_fabrication">
    <Icon texture="Content/UI/TalentsIcons3.png" sheetindex="6,6" sheetelementsize="128,128" />
    <Description tag="talentdescription.unlockrecipe">
      <Replace tag="[itemname]" value="entityname.robotupgradebelt" color="gui.orange" />
    </Description>
    <Description tag="talentdescription.robotbeltresistance" />
    <AbilityGroupEffect abilityeffecttype="None">
      <Abilities>
        <CharacterAbilityGiveResistance resistanceid="blunttrauma" multiplier="0.8" />
      </Abilities>
    </AbilityGroupEffect>
    <AddedRecipe itemidentifier="robotupgradebelt" />
  </Talent>
  <Talent identifier="robot_clothes_fabrication">
    <Icon texture="Content/UI/TalentsIcons3.png" sheetindex="5,6" sheetelementsize="128,128" />
    <Description tag="talentdescription.unlockrecipe">
      <Replace tag="[itemname]" value="entityname.robotupgradeclothes" color="gui.orange" />
    </Description>
    <AddedRecipe itemidentifier="robotupgradeclothes" />
  </Talent>

  <!-- Ветка Фабрикатора (Вместо Энергетика) -->
  <Talent identifier="robot_crafter_tier1">
    <Icon texture="Content/UI/TalentsIcons3.png" sheetindex="6,5" sheetelementsize="128,128" />
    <Description tag="talentdescription.robot_crafter_tier1" />
    <AbilityGroupEffect abilityeffecttype="None">
      <Abilities>
        <CharacterAbilityGivePermanentStat statidentifier="tool~toolmaintenance" stattype="IncreaseFabricationQuality" value="1" setvalue="true" />
        <CharacterAbilityGivePermanentStat statidentifier="reactorfuel" stattype="IncreaseFabricationQuality" value="1" setvalue="true" />
      </Abilities>
    </AbilityGroupEffect>
  </Talent>

  <Talent identifier="robot_crafter_weapons">
    <Icon texture="Content/UI/TalentsIcons1.png" sheetindex="2,2" sheetelementsize="128,128" />
    <Description tag="talentdescription.robot_crafter_weapons" />
    <AbilityGroupEffect abilityeffecttype="None">
      <Abilities>
        <CharacterAbilityGivePermanentStat statidentifier="weapon" stattype="IncreaseFabricationQuality" value="1" setvalue="true" />
      </Abilities>
    </AbilityGroupEffect>
  </Talent>

  <Talent identifier="robot_crafter_power">
    <Icon texture="Content/UI/TalentsIcons3.png" sheetindex="1,5" sheetelementsize="128,128" />
    <Description tag="talentdescription.robot_crafter_power" />
    <AbilityGroupEffect abilityeffecttype="None">
      <Abilities>
        <CharacterAbilityGivePermanentStat statidentifier="mobilebattery" stattype="IncreaseFabricationQuality" value="1" setvalue="true" />
      </Abilities>
    </AbilityGroupEffect>
  </Talent>

  <Talent identifier="robot_crafter_speed">
    <Icon texture="Content/UI/TalentsIcons2.png" sheetindex="4,3" sheetelementsize="128,128" />
    <Description tag="talentdescription.robot_crafter_speed" />
    <AbilityGroupEffect abilityeffecttype="None">
      <Abilities>
        <CharacterAbilityGiveItemStatToTags tags="fabricator" stattype="FabricationSpeed" value="1.5" />
        <CharacterAbilityGiveItemStatToTags tags="deconstructor" stattype="DeconstructorSpeed" value="1.5" />
      </Abilities>
    </AbilityGroupEffect>
  </Talent>

  <Talent identifier="robot_crafter_refiner">
    <Icon texture="Content/UI/TalentsIcons2.png" sheetindex="6,3" sheetelementsize="128,128" />
    <Description tag="talentdescription.robot_crafter_refiner">
      <Replace tag="[chance]" value="50" color="gui.green" />
    </Description>
    <AbilityGroupEffect abilityeffecttype="OnItemDeconstructedMaterial">
      <Conditions>
        <AbilityConditionServerRandom randomchance="0.5" />
        <AbilityConditionItem tags="ore" />
      </Conditions>
      <Abilities>
        <CharacterAbilityModifyValue multiplyvalue="2" />
      </Abilities>
    </AbilityGroupEffect>
  </Talent>
</Talents>